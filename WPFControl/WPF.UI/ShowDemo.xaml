<Window x:Class="WPF.UI.ShowDemo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.UI"
        xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
        mc:Ignorable="d"
        Title="ShowDemo" Height="450" Width="800">
    

    <Grid x:Name="LayoutRoot">
        <ed:Arc ArcThickness="10" Opacity="0.8"  x:Name="arcprocess" Width="400" Height="400"
                     
ArcThicknessUnit="Pixel"
EndAngle="135"
StartAngle="-135"
Stretch="None"
StrokeEndLineCap="Round"
StrokeStartLineCap="Round" >
            <ed:Arc.Fill>
                <SolidColorBrush Color="Green" />
            </ed:Arc.Fill>
            </ed:Arc>
        <ed:Arc ArcThickness="10" Opacity="0.8"  x:Name="arcbackground" Width="400" Height="400"
ArcThicknessUnit="Pixel"
EndAngle="360"
StartAngle="0"
Stretch="None"
StrokeEndLineCap="Round"
StrokeStartLineCap="Round" >
            <ed:Arc.Fill>
                <SolidColorBrush Color="Gray" />
            </ed:Arc.Fill>
        </ed:Arc>
    </Grid>
</Window>
