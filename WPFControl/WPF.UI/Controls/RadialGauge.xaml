<UserControl x:Class="WPF.UI.Controls.RadialGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--扇形仪表盘-->
    <Grid>
        <Viewbox>
            <Grid Width="30" Height="30">
                <!--<Grid.Background>
                    <RadialGradientBrush Center="0.5,0.5" 
                                     GradientOrigin="0.5,0.5"
                                     RadiusX="0.5" 
                                     RadiusY="0.5">
                        <GradientStop Color="#FF89979C" Offset="0.0" />
                        <GradientStop Color="#FF515156" Offset="1.0" />
                    </RadialGradientBrush>
                </Grid.Background>
                <Grid.Clip>
                    <EllipseGeometry Center="15,15.7" RadiusX="13" RadiusY="13" />
                </Grid.Clip>-->
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Path  IsHitTestVisible="False" Stroke="BlueViolet" StrokeThickness="1">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="2,15">
                                <ArcSegment  Point="28,15" Size="13,13" SweepDirection="Clockwise" IsLargeArc="True" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="5" Color="Black" Direction="270" ShadowDepth="0" />
                    </Path.Effect>
                </Path>
                <Canvas >
                    <Line X1="2.5" Y1="15" X2="4" Y2="15" Stroke="White" StrokeThickness="0.2" />
                    <Line X1="2.5" Y1="14" X2="4" Y2="14.1" Stroke="White" StrokeThickness="0.2" />
                </Canvas>

                
                <TextBlock FontSize="3" Opacity="0.6" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">仪表盘</TextBlock>
            </Grid>
            
        </Viewbox>
    </Grid>
</UserControl>
