<UserControl x:Class="WPF.UI.Controls.RoundInstrument"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.UI.Controls"
        xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
        mc:Ignorable="d" Height="410" Width="410">
    <Grid>
        <Viewbox>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="400" Grid.RowSpan="2">
                    <Ellipse  
                Height="400"  
                Width="400" >
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF53555B" Offset="0" />
                                <GradientStop Color="#FF4D4D58" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="20" Color="#FF000000" Direction="270" ShadowDepth="1" />
                        </Ellipse.Effect>
                    </Ellipse>


                    <ed:Arc ArcThickness="10" Opacity="0.8"  x:Name="arcprocess" Width="400" Height="400"
                     
ArcThicknessUnit="Pixel"
EndAngle="135"
StartAngle="-135"
Stretch="None"
StrokeEndLineCap="Round"
StrokeStartLineCap="Round" >
                        <ed:Arc.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">

                                <GradientStop Color="Lime" Offset="0"></GradientStop>
                                <GradientStop Color="#FFFFF500" Offset="0.2"></GradientStop>
                                <GradientStop Color="#FFFF9800" Offset="0.8"></GradientStop>
                                <GradientStop Color="#FFFD0000" Offset="1" />
                            </LinearGradientBrush>
                        </ed:Arc.Fill>
                    </ed:Arc>
                    <ed:Arc ArcThickness="10"   x:Name="arckd" Width="400" Height="400"
                    Fill="#2E1C5C"
ArcThicknessUnit="Pixel"
EndAngle="135"
StartAngle="-135"
Stretch="None"
StrokeEndLineCap="Round"
StrokeStartLineCap="Round" >

                    </ed:Arc>

                    <Path RenderTransformOrigin="0.5,0.5" Name="guideline">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-0"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Path.RenderTransform>

                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="200,20">
                                    <LineSegment Point="190,200" />
                                    <ArcSegment Size="10,15" Point="210,200" SweepDirection="Counterclockwise" />

                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0000" Offset="0" />
                                <GradientStop Color="#0000FF" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Canvas Name="tickcanvas"   >
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-45" CenterX="200" CenterY="200"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="dddd" Name="txtValue" Grid.Row="1" HorizontalAlignment="Center" Foreground="White" FontSize="35"></TextBlock>
                </Grid>
            </Grid>

        </Viewbox>
    </Grid>
    
</UserControl>
