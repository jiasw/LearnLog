<UserControl x:Class="WPF.UI.Controls.WaveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.UI.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="900">
    <Grid Margin="-80,0,0,0">

        <hc:Arc Width="300" Height="300"  Stroke="White" StrokeThickness="2" StartAngle="0" EndAngle="360"></hc:Arc>

        
        <Path  Fill="Red" HorizontalAlignment="Left" Stretch="Fill" VerticalAlignment="Top" Width="1500" Height="395" >
            <Path.Clip>
                <EllipseGeometry>
                    
                </EllipseGeometry>
                
            </Path.Clip>
            <Path.Data>
                <PathGeometry>
                    <PathGeometry.Transform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0"/>
                        </TransformGroup>
                    </PathGeometry.Transform>
                    <PathFigure StartPoint="0,200">
                        <!-- 绘制正弦波 -->
                        <BezierSegment Point1="100,100" Point2="200,300" Point3="300,200" />
                        <BezierSegment Point1="400,100" Point2="500,300" Point3="600,200" />
                        <BezierSegment Point1="700,100" Point2="800,300" Point3="900,200" />
                        <PolyLineSegment Points="900,400 0,400"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Grid>


</UserControl>
