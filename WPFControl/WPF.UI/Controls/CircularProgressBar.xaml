<UserControl x:Class="WPF.UI.Controls.CircularProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Viewbox>
            <Grid Width="34" Height="34">
                <Path Stroke="Fuchsia" Opacity="0.7" StrokeThickness="1" IsHitTestVisible="False" >
                    <Path.Data>
                        <EllipseGeometry   Center="17,17" RadiusX="14" RadiusY="14"/>
                    </Path.Data>
                </Path>
                <Path Name="myCycleProcessBar1" Data="M17,3 A14,14 0 0 1 16,3 " Stroke="Green" StrokeThickness="1" Height="34" Width="34" VerticalAlignment="Center" HorizontalAlignment="Center">
                </Path>
                
                <Label Name="lbValue" Content="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" />
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
