<UserControl x:Class="WPF.UI.Controls.PipeLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.UI.Controls"
             xmlns:cvt="clr-namespace:WPF.UI.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <cvt:MultiplesValueConverter
				x:Key="multiConverter" />
            <cvt:VisibilityConverter
				x:Key="visibilityConverter" />
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid>
        <Grid
	Name="grid1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
			Width="auto" />
                <ColumnDefinition
			Width="*" />
                <ColumnDefinition
			Width="auto" />
            </Grid.ColumnDefinitions>
            <Canvas
		Name="canvas1"
		Grid.Column="0" 
		ClipToBounds="True"
		Width="{Binding ElementName=grid1, Path=ActualHeight}"
		Height="{Binding ElementName=grid1, Path=ActualHeight}">
                <Ellipse
			Name="ellipe1"
			Grid.Column="0"
			Margin="0,0,0,0"
			Width="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=2}"
			Height="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=2}"
			Canvas.Left="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=0}"
			Canvas.Top="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=0}">
                    <Shape.Fill>
                        <RadialGradientBrush
					RadiusX="0.5"
					RadiusY="0.5"
					GradientOrigin="0.5,0.5">
                            <GradientStop
						Offset="0"
						Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                            <GradientStop
						Offset="0.5"
						Color="{Binding Path=CenterColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                            <GradientStop
						Offset="1"
						Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                        </RadialGradientBrush>
                    </Shape.Fill>
                </Ellipse>
            </Canvas>
            <Canvas
		Name="canvas2"
		Grid.Column="2"
		ClipToBounds="True"
		Width="{Binding ElementName=grid1, Path=ActualHeight}"
		Height="{Binding ElementName=grid1, Path=ActualHeight}">
                <Ellipse
			Name="ellipe2"
			Width="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=2}"
			Height="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=2}"
			Canvas.Left="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=-1}"
			Canvas.Top="{Binding ElementName=grid1, Path=ActualHeight, Converter={StaticResource multiConverter}, ConverterParameter=-1}">
                    <Shape.Fill>
                        <RadialGradientBrush
					RadiusX="0.5"
					RadiusY="0.5"
					GradientOrigin="0.5,0.5">
                            <GradientStop
						Offset="0"
						Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                            <GradientStop
						Offset="0.5"
						Color="{Binding Path=CenterColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                            <GradientStop
						Offset="1"
						Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                        </RadialGradientBrush>
                    </Shape.Fill>
                </Ellipse>
            </Canvas>
            <Rectangle
		Grid.Column="1"
		Stretch="Fill">
                <Shape.Fill>
                    <LinearGradientBrush
				StartPoint="0,0"
				EndPoint="0,1">
                        <GradientStop
					Offset="0"
					Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                        <GradientStop
					Offset="0.5"
					Color="{Binding Path=CenterColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                        <GradientStop
					Offset="1"
					Color="{Binding Path=EdgeColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
                    </LinearGradientBrush>
                </Shape.Fill>
            </Rectangle>
        </Grid>
        <Path
	Name="path1"
	StrokeDashArray="5,5"
	Visibility="{Binding Path=PipeLineActive, Converter={StaticResource visibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}"
	StrokeThickness="{Binding Path=PipeLineWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}"
	StrokeDashOffset="{Binding Path=LineOffect, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}">
            <Shape.Stroke>
                <SolidColorBrush
			Color="{Binding Path=ActiveLineCenterColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PipeLine}}}" />
            </Shape.Stroke>
        </Path>
    </Grid>
</UserControl>
