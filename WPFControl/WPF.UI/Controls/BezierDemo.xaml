<UserControl x:Class="WPF.UI.Controls.BezierDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF.UI.Controls"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="400" d:DesignWidth="800">
    <Canvas x:Name="WaveCanvas" Background="Transparent">
        <Canvas.Clip>
            <RectangleGeometry Rect="0,0,400,400"  />
        </Canvas.Clip>


        <Path Stroke="Blue" StrokeThickness="2" Fill="Red" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform X="-40"/>
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,200">
                        <BezierSegment Point1="150,50" Point2="250,350" Point3="400,200" />
                        <BezierSegment Point1="550,50" Point2="650,350" Point3="800,200" />
                        <PolyLineSegment Points="800 400,0 400,0 200"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Canvas>
</UserControl>
